# An * ensures that everything will be ignored.
*
# You can whitelist files/folders with !, these will not be ignored.
!*.yaml
!.gitignore
!*.md
# Blueprints
!blueprints/
!automation/
!depricated_climate/
!homeassistant/
!script/
# Automations
!automations/
!climate/
# Development files
!package.json
!package-lock.json
!.env.example
!tests/
!*.js


# Ignore folders.
.storage/
.cloud/
.google.token/

# Ensure these YAML files are ignored, otherwise your secret data/credentials will leak.
ip_bans.yaml
secrets.yaml
known_devices.yaml

# Environment files (contain secrets)
.env
.env.local
.env.production

# Node modules and development artifacts
node_modules/
coverage/
